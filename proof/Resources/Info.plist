	<string>proof uses the camera to film a walkthrough of your room so it can rebuild it in 3D and flag things a small child could reach.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>proof saves your checklist and room images to your photo library when you ask it to.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>InstrumentSans-Medium.ttf</string>
		<string>InstrumentSans-SemiBold.ttf</string>
		<string>InstrumentSans-Bold.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
